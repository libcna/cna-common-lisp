  "description": "The whole CNA C ABI surface CNA-Lisp binds. Nothing outside this file reaches the native library. Types are not written here: the generator reads them from the canonical CNA headers so a hand-copied signature can never drift from the ABI it claims to describe.",
  "header_roots": {
    "qualification": "modules/c-api/include",
    "note": "A header root is supplied to the generator with --headers; it is never read at runtime."
  },
  "admitted_abi_versions": [
    {
